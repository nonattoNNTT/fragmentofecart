# Auto detect text files and perform LF normalization
* text=auto

#
# Unity YAML / source (text)
#
*.cs               text diff=csharp
*.shader           text
*.shadergraph      text
*.cginc            text
*.hlsl             text
*.json             text
*.txt              text
*.md               text
*.unity            text
*.prefab           text
*.mat              text
*.asset            text
*.meta             text
*.inputactions     text
*.asmdef           text

#
# Git LFS - binarios (Unity)
#
# Imagens
*.png              filter=lfs diff=lfs merge=lfs -text
*.jpg              filter=lfs diff=lfs merge=lfs -text
*.jpeg             filter=lfs diff=lfs merge=lfs -text
*.gif              filter=lfs diff=lfs merge=lfs -text
